# Local development placeholders. Never use these database credentials in production.
# Docker service DNS is "db"; PostgreSQL is not published to the host.
DATABASE_URL=postgresql+psycopg://observer:observer-dev-only@db:5432/wallet_observer

# Runtime defaults: fixture mode makes no provider or Telegram requests.
APP_MODE=fixture
DATABASE_TIMEOUT_SECONDS=3
WORKER_POLL_SECONDS=5
# Integrations remain unavailable until their implementation issues land.
HELIUS_ENABLED=false
TELEGRAM_ENABLED=false

# Optional credentials; never exposed in logs or the frontend.
HELIUS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
